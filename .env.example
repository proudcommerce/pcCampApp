# Admin-Key fuer Voting-Admin und Content-Verwaltung.
# Wird von docker-compose als Umgebungsvariable an PHP-FPM uebergeben.
# WICHTIG: In Production einen sicheren Key setzen!
VOTING_ADMIN_KEY=change-me-in-production

# Host-Ports (Container-intern bleibt 5173)
DEV_PORT=5173
PROD_PORT=5174

# Whitelist fuer Canonical-URL und OpenGraph/Twitter-Tags.
# Komma-getrennt, ohne Scheme/Port. Nicht-whitelistete Hosts (z.B. durch
# manipulierte Host-/X-Forwarded-Host-Header) werden auf den ersten Eintrag
# zurueckgefuehrt — verhindert SEO-Hijacking und Social-Preview-Poisoning.
# Default `localhost` ist nur fuer Dev/Healthcheck; in Prod die echte(n)
# Event-Domain(s) eintragen, z.B.:
#   TRUSTED_HOSTS=camp.example.com,www.camp.example.com
TRUSTED_HOSTS=localhost

# Alle laufzeit-aenderbaren Daten (event.json, menu.json, votes.json, ...)
# liegen im Host-Verzeichnis ./content/. Es wird beim ersten Container-Start
# aus ./seed/ befuellt. Backup/Restore: `tar c(f|xf) content-backup.tar content/`.
