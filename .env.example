# Admin-Key fuer Voting-Admin und Content-Verwaltung.
# Wird von docker-compose als Umgebungsvariable an PHP-FPM uebergeben.
# WICHTIG: In Production einen sicheren Key setzen!
VOTING_ADMIN_KEY=change-me-in-production

# Host-Ports (Container-intern bleibt 5173)
DEV_PORT=5173
PROD_PORT=5174

# Alle laufzeit-aenderbaren Daten (event.json, menu.json, votes.json, ...)
# liegen im Host-Verzeichnis ./content/. Es wird beim ersten Container-Start
# aus ./seed/ befuellt. Backup/Restore: `tar c(f|xf) content-backup.tar content/`.
